<!--
  In-headset HUD that floats behind the board. Text is updated at runtime by
  src/prism-game.ts through the element ids below.
-->
<style>
  .hud {
    flex-direction: column;
    width: 400px;
  }

  .content {
    flex-direction: column;
    gap: 6px;
    padding-top: 18px;
    padding-left: 22px;
    padding-right: 22px;
    padding-bottom: 8px;
  }

  .top {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .eyebrow {
    color: #f5d90a;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1.4px;
  }

  .stars {
    flex-direction: row;
    gap: 4px;
  }

  .star {
    width: 22px;
    height: 22px;
    color: #3d3f4a;
  }

  .title {
    color: #fafaf7;
    font-size: 30px;
    font-weight: 700;
  }

  .tip {
    color: #d3d5de;
    font-size: 18px;
  }

  .meta-row {
    flex-direction: row;
    justify-content: space-between;
  }

  .meta {
    color: #9fd8ff;
    font-size: 15px;
    font-weight: 600;
  }

  .buttons {
    flex-direction: row;
    gap: 10px;
    padding-left: 22px;
    padding-right: 22px;
    padding-bottom: 18px;
    padding-top: 6px;
  }
</style>
<Panel class="hud">
  <div class="content">
    <div class="top">
      <div id="level-label" class="eyebrow">LEVEL 1 / 8</div>
      <div class="stars">
        <Star id="star-1" class="star"></Star>
        <Star id="star-2" class="star"></Star>
        <Star id="star-3" class="star"></Star>
      </div>
    </div>
    <div id="level-title" class="title">First Light</div>
    <div id="tip-text" class="tip">Hold your palm over the light, then tilt it.</div>
    <div class="meta-row">
      <div id="freeze-text" class="meta">Palms only</div>
      <div id="streak-text" class="meta"></div>
    </div>
  </div>
  <div class="buttons">
    <Button id="reset-button">
      <ButtonIcon>
        <RotateCcw></RotateCcw>
      </ButtonIcon>
      <ButtonLabel>Reset</ButtonLabel>
    </Button>
    <Button id="recenter-button">
      <ButtonIcon>
        <LocateFixed></LocateFixed>
      </ButtonIcon>
      <ButtonLabel>Recenter</ButtonLabel>
    </Button>
    <Button id="next-button" style="display: none">
      <ButtonIcon>
        <ArrowRight></ArrowRight>
      </ButtonIcon>
      <ButtonLabel id="next-label">Next</ButtonLabel>
    </Button>
  </div>
</Panel>
