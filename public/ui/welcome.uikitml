<!--
  Browser landing panel. Panel, Button, ButtonIcon and ButtonLabel come from
  the bundled Horizon kit; RectangleGoggles, LogIn and Sparkles are Lucide
  icons. The :dark styles apply because iwsdk.config.json prefers dark.
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 440px;
  }

  .panel-content {
    flex-direction: column;
    gap: 8px;
    padding: 24px;
  }

  .eyebrow-row {
    flex-direction: row;
    gap: 8px;
    align-items: center;
  }

  .eyebrow-icon {
    width: 18px;
    height: 18px;
    color: #f5d90a;
  }

  .eyebrow {
    color: #6b5a00;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1.4px;
  }

  .eyebrow:dark {
    color: #f5d90a;
  }

  .heading {
    color: #1c1d20;
    font-size: 32px;
    font-weight: 700;
  }

  .heading:dark {
    color: #fafaf7;
  }

  .body {
    color: #3a3b40;
    font-size: 19px;
  }

  .body:dark {
    color: #dddfe3;
  }

  .button {
    justify-content: flex-start;
    margin-left: 24px;
    margin-right: 24px;
    margin-bottom: 24px;
  }

  .button-label {
    transform-translate-y: 1px;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div class="eyebrow-row">
      <Sparkles class="eyebrow-icon"></Sparkles>
      <div class="eyebrow">PALM PRISM</div>
    </div>
    <div class="heading">Your hands are the mirrors.</div>
    <div class="body">Bend light with your palms to wake every crystal.</div>
    <div class="body">Pinch to freeze a mirror in place. No controllers needed.</div>
  </div>
  <Button id="xr-button" class="button">
    <ButtonIcon>
      <RectangleGoggles></RectangleGoggles>
    </ButtonIcon>
    <ButtonLabel class="button-label">Enter VR</ButtonLabel>
  </Button>
  <Button id="exit-button" class="button" style="display: none">
    <ButtonIcon>
      <LogIn></LogIn>
    </ButtonIcon>
    <ButtonLabel class="button-label">Exit to Browser</ButtonLabel>
  </Button>
</Panel>
